# Required: workers, judge and the frontier competitor all run on OpenAI.
OPENAI_API_KEY=sk-...

# Optional: LangSmith tracing. When unset, src/lib/trace.ts prints a local span tree instead.
# LANGSMITH_API_KEY=lsv2_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=agentic-parallelism-langchain

# Optional: an OpenAI-compatible local server (LM Studio, Ollama, vLLM).
# Snippet 04 uses this slot for the `restricted`/`eu` request. Absent => that request stops with a reason.
# LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
# LOCAL_OPENAI_MODEL=qwen3-8b

# Optional: durable checkpoints. Absent => MemorySaver.
# LANGGRAPH_SQLITE_PATH=./checkpoints.sqlite

# Optional: port for the local Agent Server started by snippet 06.
# LANGGRAPH_DEV_PORT=2024

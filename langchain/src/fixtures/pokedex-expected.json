{
  "contractVersion": "1.0.0",
  "expected": {
    "ordinary-discovery": {
      "claims": [
        {
          "path": "searchable",
          "operator": "set-equals",
          "value": [
            "ability",
            "generation",
            "move",
            "pokedex",
            "pokemon",
            "pokemon-species",
            "region",
            "type"
          ]
        },
        { "path": "listOnly", "operator": "contains", "value": "evolution-chain" }
      ],
      "evidence": { "requiredTools": ["pokedex_list_resources"] }
    },
    "ordinary-pikachu": {
      "claims": [
        { "path": "name", "operator": "equals", "value": "pikachu" },
        { "path": "height", "operator": "equals", "value": 4 },
        { "path": "weight", "operator": "equals", "value": 60 },
        { "path": "types", "operator": "contains", "value": "electric" }
      ],
      "evidence": { "requiredTools": ["pokedex_search", "pokedex_get"] }
    },
    "ordinary-ability": {
      "claims": [
        { "path": "abilities", "operator": "contains", "value": "overgrow" },
        {
          "path": "hiddenAbility",
          "operator": "equals",
          "value": "chlorophyll",
          "support": { "operator": "contains-all", "values": ["chlorophyll", true] }
        }
      ],
      "evidence": { "requiredTools": ["pokedex_search", "pokedex_get"] }
    },
    "ordinary-comparison": {
      "claims": [
        {
          "path": "heavier",
          "operator": "equals",
          "value": "charmander",
          "support": { "operator": "contains-all", "values": [85, 69] }
        },
        {
          "path": "difference",
          "operator": "equals",
          "value": 16,
          "support": { "operator": "contains-all", "values": [85, 69] }
        }
      ],
      "evidence": { "requiredTools": ["pokedex_search", "pokedex_get"], "minimumGets": 2 }
    },
    "pagination-resume": {
      "claims": [
        {
          "path": "names",
          "operator": "set-equals",
          "value": ["charmander", "charmeleon", "charizard"]
        }
      ],
      "evidence": { "requiredTools": ["pokedex_list"], "minimumPages": 2, "requiresCursor": true }
    },
    "pagination-empty-page": {
      "claims": [
        {
          "path": "names",
          "operator": "set-equals",
          "value": ["bulbasaur", "ivysaur", "venusaur", "squirtle", "wartortle", "blastoise"]
        }
      ],
      "evidence": {
        "requiredTools": ["pokedex_list"],
        "minimumPages": 3,
        "requiresEmptyPageContinuation": true
      }
    },
    "cascade-evolution": {
      "claims": [
        { "path": "laterSpecies", "operator": "set-equals", "value": ["ivysaur", "venusaur"] }
      ],
      "evidence": {
        "requiredTools": ["pokedex_search", "pokedex_get"],
        "requiredRefs": ["pokemon-species/1", "evolution-chain/1"]
      }
    },
    "cascade-generation-region": {
      "claims": [
        { "path": "region", "operator": "equals", "value": "kanto" },
        { "path": "pokedexes", "operator": "contains", "value": "kanto" }
      ],
      "evidence": {
        "requiredTools": ["pokedex_search", "pokedex_get"],
        "requiredRefs": ["region/1"]
      }
    },
    "failure-rate-limit": {
      "claims": [{ "path": "baseExperience", "operator": "equals", "value": 112 }],
      "evidence": {
        "requiredTools": ["pokedex_search", "pokedex_get"],
        "requiredErrors": ["RATE_LIMITED"],
        "requiresRetry": true
      }
    },
    "failure-cascade-500": {
      "claims": [{ "path": "color", "operator": "equals", "value": "red" }],
      "evidence": {
        "requiredTools": ["pokedex_search", "pokedex_get"],
        "requiredErrors": ["UPSTREAM_UNAVAILABLE"],
        "requiresRetry": true
      }
    },
    "reasoning-four-records": {
      "claims": [
        {
          "path": "names",
          "operator": "set-equals",
          "value": ["ivysaur", "venusaur"],
          "support": {
            "operator": "contains-all",
            "values": [69, 130, 1000, 85]
          }
        }
      ],
      "evidence": {
        "requiredTools": ["pokedex_list", "pokedex_get"],
        "efficiency": {
          "initialTool": "pokedex_list",
          "initialArguments": {
            "resource": "pokemon",
            "pageSize": 4
          },
          "selection": "all",
          "maxParallel": 4,
          "requireParallel": true
        }
      }
    },
    "reasoning-limited-followups": {
      "claims": [
        {
          "path": "names",
          "operator": "set-equals",
          "value": ["ivysaur"],
          "support": {
            "operator": "contains-all",
            "values": [69, 130]
          }
        }
      ],
      "evidence": {
        "requiredTools": ["pokedex_list", "pokedex_get"],
        "efficiency": {
          "initialTool": "pokedex_list",
          "initialArguments": {
            "resource": "pokemon",
            "pageSize": 4
          },
          "selection": "first-within-budget",
          "maxParallel": 4,
          "requireParallel": true
        }
      }
    },
    "reasoning-selective-comparison": {
      "claims": [
        {
          "path": "heavier",
          "operator": "equals",
          "value": "charmander",
          "support": {
            "operator": "contains-all",
            "values": [69, 85]
          }
        },
        {
          "path": "difference",
          "operator": "equals",
          "value": 16,
          "support": {
            "operator": "contains-all",
            "values": [69, 85]
          }
        }
      ],
      "evidence": {
        "requiredTools": ["pokedex_list", "pokedex_get"],
        "efficiency": {
          "initialTool": "pokedex_list",
          "initialArguments": {
            "resource": "pokemon",
            "pageSize": 4
          },
          "selection": "names",
          "names": ["bulbasaur", "charmander"],
          "maxParallel": 4,
          "requireParallel": true
        }
      }
    },
    "reasoning-no-followup": {
      "claims": [
        {
          "path": "names",
          "operator": "set-equals",
          "value": ["bulbasaur", "ivysaur", "venusaur"]
        }
      ],
      "evidence": {
        "requiredTools": ["pokedex_list"],
        "efficiency": {
          "initialTool": "pokedex_list",
          "initialArguments": {
            "resource": "pokemon",
            "pageSize": 4
          },
          "selection": "none",
          "maxParallel": 4,
          "requireParallel": false
        }
      }
    }
  }
}

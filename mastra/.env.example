# Required for every snippet that makes a model call.
OPENAI_API_KEY=sk-...

# Model ids are written inline in src/lib/models.ts.

# Optional local OpenAI-compatible slot (LM Studio / Ollama).
# When unset, the local competitor in 04-distribute is skipped and the ledger says so.
# LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
# LOCAL_OPENAI_MODEL=qwen2.5-coder-7b

# Optional second provider. Not required; snippets skip cleanly when absent.
# ANTHROPIC_API_KEY=

# Port used by the A2A remote worker server (06, and 04's remote competitor).
REMOTE_PORT=4112

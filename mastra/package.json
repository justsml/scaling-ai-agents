{
  "name": "scaling-ai-agents-mastra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "bun run src/lib/setup.ts",
    "check": "tsc --noEmit",
    "test": "bun test ./test",
    "dev": "mastra dev --request-context-presets ./presets.json",
    "all": "bun run src/lib/all.ts",
    "advanced:remote": "bun run src/advanced/remote-a2a.ts",
    "snippet:01": "bun run src/snippets/01-decompose.ts",
    "snippet:02": "bun run src/snippets/02-constrain.ts",
    "snippet:03": "bun run src/snippets/03-compile.ts",
    "snippet:04": "bun run src/snippets/04-batching.ts",
    "snippet:05": "bun run src/snippets/05-pokedex.ts",
    "snippet:06": "bun run src/snippets/06-model-router.ts",
    "snippet:11": "bun src/snippets/11-fanout-node.ts",
    "snippet:12": "bun run src/snippets/12-business-advice.ts"
  },
  "dependencies": {
    "@mastra/client-js": "latest",
    "@mastra/core": "latest",
    "@mastra/evals": "latest",
    "@mastra/hono": "^1.7.6",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "^1.17.5",
    "hono": "^4.13.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22",
    "mastra": "latest",
    "typescript": "^5.7.0"
  }
}

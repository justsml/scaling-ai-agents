{
  "version": "rules-2026-09-05",
  "rules": [
    { "id": "consequential-push", "pattern": "\\b(push|deploy|apply .* to main|merge to main)\\b", "flags": "i", "action": "consequential" },
    { "id": "code-fix-tests", "pattern": "\\b(fix|make)\\b.*\\btests? (pass|green)\\b", "flags": "i", "route": "code", "tags": ["hard"] },
    { "id": "code-verbs", "pattern": "\\b(refactor|debug|implement|stack trace|unit test|typescript|function)\\b", "flags": "i", "route": "code" },
    { "id": "long-context-logs", "pattern": "\\b(logs?|transcripts?|investigate|evidence|root cause|1006|disconnect)\\b", "flags": "i", "route": "long-context" },
    { "id": "general-status", "pattern": "^(what is|what's) the (current )?status\\b", "flags": "i", "route": "general" },
    { "id": "general-classify", "pattern": "\\b(classify|categori[sz]e|format (this|the)|extract the)\\b", "flags": "i", "route": "general" }
  ]
}

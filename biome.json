{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 56
  },
  "overrides": [
    {
      "includes": ["harness/**", "**/test/**", "**/*.json", "**/*.md"],
      "formatter": { "lineWidth": 100 }
    }
  ]
}
